# Exemplo de configuração.
# Local: gere o .env.local com o comando do README (segredos aleatórios).
# Produção: preencha somente no ambiente de execução.
# Nunca coloque credenciais reais no Git.

# --- Produção (docker-compose.yml) ---
ACME_EMAIL=
TYPEBOT_DOMAIN=
CHATWOOT_DOMAIN=

# --- Comuns (produção e local) ---
POSTGRES_TYPEBOT_PASSWORD=
POSTGRES_CHATWOOT_PASSWORD=
REDIS_PASSWORD=
ENCRYPTION_SECRET=      # exatamente 32 caracteres
NEXTAUTH_SECRET=
SECRET_KEY_BASE=

# --- WhatsApp Cloud API (Meta) ---
META_PHONE_NUMBER_ID=
META_BUSINESS_ACCOUNT_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
